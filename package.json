{
	"name": "shepherd",
	"version": "0.1.0",
	"type": "module",
	"private": true,
	"description": "Shepherd, an agent package built on Troupe.",
	"scripts": {
		"compile": "bun scripts/build.ts",
		"compile:all": "bun scripts/build.ts --all",
		"watch": "bun scripts/watch.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"check": "biome check .",
		"check:all": "bun run typecheck && bun run check",
		"checks": "bun run check:all && bun test",
		"test": "bun test",
		"evals:shepherd": "bun evals/shepherd/run.ts",
		"prepare": "husky"
	},
	"dependencies": {
		"troupe": "git+https://github.com/ag0os/troupe.git#a8c7911215974fcf2498d739981bbbfa6a047286",
		"yaml": "^2",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.4",
		"@types/bun": "1.2.19",
		"@types/node": "24.2.0",
		"husky": "9.1.7",
		"typescript": "5.9.2"
	}
}
